{
  "name": "jambagecom/jfmulticontent",
  "type": "typo3-cms-extension",
  "description": "Arranges multiple contents into one content element with multiple columns, accordions, tabs, slider, slidedeck, easyAccordion or Booklet for TYPO3 CMS",
  "keywords": [
    "TYPO3",
    "extension",
    "multiple",
    "content"
  ],
  "support": {
    "issues": "https://github.com/franzholz/jfmulticontent/issues"
  },
  "homepage": "https://jambage.com",
  "authors": [
    {
      "name": "Franz Holzinger",
      "role": "Developer",
      "homepage": "https://ttproducts.de"
    },
    {
      "name": "Jürgen Furrer",
      "role": "Developer"
    }
  ],
  "license": [
    "GPL-2.0-or-later"
  ],
  "require": {
    "php": "^8.2",
    "typo3/cms-core": "^14.3",
    "jambagecom/div2007": "^2.4"
  },
  "suggest": {
    "bugfix/patchlayout": "^0.4",
    "quellenform/t3x-lib-jquery": "^4"
  },
  "autoload": {
    "psr-4": {
      "JambageCom\\Jfmulticontent\\": "Classes"
    },
    "classmap": [
      "Classes",
      "pi1"
    ]
  },
  "replace": {
    "typo3-ter/jfmulticontent": "self.version"
  },
  "extra": {
    "typo3/cms": {
      "extension-key": "jfmulticontent",
      "version": "2.16.2",
      "Package": {
          "providesPackages": {}
      }
    }
  },
  "require-dev": {
    "friendsofphp/php-cs-fixer": "^3.45"
  },
  "config": {
    "allow-plugins": {
      "typo3/cms-composer-installers": true,
      "typo3/class-alias-loader": true
    }
  }
}
